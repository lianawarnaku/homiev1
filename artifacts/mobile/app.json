{
  "expo": {
    "name": "SweetMate",
    "slug": "sweetmate",
    "owner": "lianawarnakulasooriyas-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/roomie-icon.png",
    "scheme": "sweetmate",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/roomie-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF6F0"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.homieapplication.homie",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "SweetMate uses your photo library only when you choose a profile photo."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/roomie-icon.png",
        "backgroundColor": "#FAF6F0"
      }
    },
    "web": {
      "favicon": "./assets/images/roomie-icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://sweetmate.info/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "66fa0c25-5e31-481a-ae0a-0a057806cf27"
      }
    }
  }
}
