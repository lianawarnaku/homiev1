{
  "expo": {
    "name": "SweetMate",
    "slug": "homie",
    "owner": "lianawarnakulasooriyas-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/sweetmate-icon.png",
    "scheme": "sweetmate",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.homieapplication.homie",
      "buildNumber": "1",
      "icon": "./assets/images/sweetmate-icon.png",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "SweetMate uses your photo library only when you choose a profile photo.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.homieapplication.homie",
      "blockedPermissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/sweetmate-adaptive-foreground.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/images/roomie-icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://sweetmate.info/"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/sweetmate-splash.png",
          "imageWidth": 224,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-calendar",
        {
          "calendarPermission": "SweetMate does not create calendar events for chores.",
          "remindersPermission": "Allow SweetMate to add your assigned chores to Apple Reminders."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "66fa0c25-5e31-481a-ae0a-0a057806cf27"
      }
    }
  }
}
